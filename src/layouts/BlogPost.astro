---
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const { frontmatter } = Astro.props;

const date = new Date(frontmatter.date);
const formatted = date.toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric'
});

const readingTime = Math.ceil((Astro.props.rawContent?.().split(/\s+/).length ?? 500) / 200);
---

<Base title={`${frontmatter.title} — Tyler Alexander Martin`} description={frontmatter.description}>
  <Nav />

  <main class="main">
    <article class="article">
      <header class="article-header fade-up">
        <div class="meta">
          <time class="date">{formatted}</time>
        </div>

        <h1 class="title">{frontmatter.title}</h1>

        {frontmatter.description && (
          <p class="description">{frontmatter.description}</p>
        )}

        <div class="rule" aria-hidden="true">
          <span>✦</span>
        </div>
      </header>

      <div class="prose fade-up fade-up-delay-1">
        {frontmatter.image && frontmatter.showHeroImage !== false && (
          frontmatter.routeMap ? (
            <div class="hero-pair">
              <figure class="hero-image">
                <img src={frontmatter.image} alt={frontmatter.imageAlt ?? frontmatter.title} />
              </figure>
              <figure class="hero-map">
                <img src={frontmatter.routeMap} alt={frontmatter.routeMapAlt ?? `${frontmatter.title} route map`} />
                {frontmatter.routeMapCaption && (
                  <figcaption>{frontmatter.routeMapCaption}</figcaption>
                )}
              </figure>
            </div>
          ) : (
            <figure class="hero-image">
              <img src={frontmatter.image} alt={frontmatter.imageAlt ?? frontmatter.title} />
            </figure>
          )
        )}
        <slot />
      </div>

      <footer class="article-footer">
        <a href="/blog" class="back-link">← Back to all posts</a>
      </footer>
    </article>
  </main>

  <div class="gallery-lightbox" data-gallery-lightbox aria-hidden="true">
    <button class="gallery-lightbox__button gallery-lightbox__close" type="button" data-lightbox-close aria-label="Close image">×</button>
    <button class="gallery-lightbox__button gallery-lightbox__prev" type="button" data-lightbox-prev aria-label="Previous image">‹</button>
    <img class="gallery-lightbox__image" data-lightbox-image alt="" />
    <button class="gallery-lightbox__button gallery-lightbox__next" type="button" data-lightbox-next aria-label="Next image">›</button>
    <div class="gallery-lightbox__count" data-lightbox-count></div>
  </div>

  <Footer />
</Base>

<script>
  const lightbox = document.querySelector('[data-gallery-lightbox]');
  const lightboxImage = document.querySelector('[data-lightbox-image]');
  const closeButton = document.querySelector('[data-lightbox-close]');
  const prevButton = document.querySelector('[data-lightbox-prev]');
  const nextButton = document.querySelector('[data-lightbox-next]');
  const count = document.querySelector('[data-lightbox-count]');

  let activeGallery = [];
  let activeIndex = 0;

  const setImage = (index) => {
    if (!lightboxImage || !count || activeGallery.length === 0) return;

    activeIndex = (index + activeGallery.length) % activeGallery.length;
    const link = activeGallery[activeIndex];
    const image = link.querySelector('img');

    lightboxImage.setAttribute('src', link.getAttribute('href') ?? image?.getAttribute('src') ?? '');
    lightboxImage.setAttribute('alt', image?.getAttribute('alt') ?? '');
    count.textContent = `${activeIndex + 1} / ${activeGallery.length}`;
  };

  const openLightbox = (link) => {
    const gallery = link.closest('.day-gallery');
    if (!lightbox || !gallery) return;

    activeGallery = Array.from(gallery.querySelectorAll('a[href]'));
    activeIndex = activeGallery.indexOf(link);
    setImage(activeIndex);
    lightbox.classList.add('is-open');
    lightbox.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  };

  const closeLightbox = () => {
    if (!lightbox) return;

    lightbox.classList.remove('is-open');
    lightbox.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  };

  document.querySelectorAll('.day-gallery a[href]').forEach((link) => {
    link.addEventListener('click', (event) => {
      event.preventDefault();
      openLightbox(link);
    });
  });

  closeButton?.addEventListener('click', closeLightbox);
  prevButton?.addEventListener('click', () => setImage(activeIndex - 1));
  nextButton?.addEventListener('click', () => setImage(activeIndex + 1));

  lightbox?.addEventListener('click', (event) => {
    if (event.target === lightbox) closeLightbox();
  });

  document.addEventListener('keydown', (event) => {
    if (!lightbox?.classList.contains('is-open')) return;

    if (event.key === 'Escape') closeLightbox();
    if (event.key === 'ArrowLeft') setImage(activeIndex - 1);
    if (event.key === 'ArrowRight') setImage(activeIndex + 1);
  });
</script>

<style>
  .main {
    padding: 3rem 2rem 4rem;
  }

  .article {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .article-header {
    margin-bottom: 3rem;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }

  .date, .reading-time {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dust);
  }

  .sep {
    color: var(--mist);
    font-size: 0.8rem;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sage);
  }

  .title {
    font-size: clamp(2rem, 5vw, 3.2rem);
    line-height: 1.15;
    margin-bottom: 1.2rem;
  }

  .description {
    font-size: 1.15rem;
    color: var(--bark);
    font-style: italic;
    line-height: 1.6;
    max-width: 560px;
    margin-bottom: 0;
  }

  .rule {
    margin: 2.5rem 0 0;
    text-align: center;
    color: var(--dust);
    font-size: 0.9rem;
    letter-spacing: 0.5em;
  }

  /* Prose */
  .prose {
    font-size: 1.05rem;
    line-height: 1.85;
    color: var(--ink);
  }

  .article-footer {
    margin-top: 5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--mist);
  }

  .hero-image {
    margin: 0 0 2rem;
  }

  .hero-image img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 14px;
    border: 1px solid var(--mist);
    box-shadow: 0 16px 40px rgba(61, 43, 31, 0.12);
  }

  .hero-pair {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(220px, 0.72fr);
    gap: 1.2rem;
    align-items: center;
    margin: 0 -4rem 2.25rem;
  }

  .hero-pair .hero-image,
  .hero-pair .hero-map {
    margin: 0;
  }

  .hero-map img {
    width: 100%;
    height: auto;
    display: block;
  }

  .hero-map figcaption {
    margin-top: 0.5rem;
    color: var(--dust);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    line-height: 1.45;
    text-align: center;
  }

  .back-link {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--bark);
  }

  @media (max-width: 900px) {
    .hero-pair {
      grid-template-columns: 1fr;
      margin-left: 0;
      margin-right: 0;
    }

    .hero-map {
      max-width: 440px;
      margin: 0 auto;
    }
  }
</style>
