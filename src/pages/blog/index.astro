---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
const posts = await Astro.glob('./*.md');
---
<Base title="Article workshop: writing"><Nav /><main style="max-width:720px;margin:3rem auto;padding:0 1rem"><h1>Article and references</h1><ul>{posts.map(post => <li><a href={post.url}>{post.frontmatter.title}</a></li>)}</ul></main></Base>
